{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amarena",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "MAIL_FROM": "Amarena Pastelería <contacto@amarenapasteleria.com>",
    "MAIL_TO": "marialorenavivasrodriguez@gmail.com"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
